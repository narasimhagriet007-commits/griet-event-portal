# --- Database (SQLite default; use postgresql+psycopg2://user:pass@host/db for Postgres)
DATABASE_URL=sqlite:///./griet_events.db

# --- CORS (comma-separated React dev/prod origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- UPI payee details used to build payment links/QR payloads
UPI_VPA=yourclub@upi
UPI_PAYEE_NAME=GRIET Events

# true  = UPI registrations with a valid, unused 12-digit UTR are marked verified immediately
# false = they stay "pending_verification" until POST /api/admin/registrations/{id}/verify
AUTO_VERIFY_UPI=true

# --- Admin endpoints (send header X-Admin-Key)
ADMIN_API_KEY=change-me

# --- Google Sheets sync: off | webhook | api
SHEETS_MODE=webhook

# webhook mode: deploy the Apps Script below as a Web App (access: Anyone)
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec

# api mode: share the sheet with the service account's email (Editor)
GOOGLE_CREDS_FILE=service_account.json
GOOGLE_SHEET_ID=your_sheet_id
GOOGLE_SHEET_TAB=Registrations

